# ==============================================
# VARIABLES DE ENTORNO - SISTEMA VETERINARIA
# ==============================================
# Copia este archivo a .env y completa con tus valores reales
# IMPORTANTE: Nunca commitees el archivo .env al repositorio

# ==============================================
# CONFIGURACIÓN GENERAL
# ==============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=Sistema Gestion Veterinaria

# ==============================================
# BASE DE DATOS
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veterinaria_db
DB_USERNAME=root
DB_PASSWORD=123456

# Connection Pool
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=20000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=1200000

# ==============================================
# JWT / SEGURIDAD
# ==============================================
# IMPORTANTE: Genera un secret seguro de al menos 256 bits (64 caracteres)
# Puedes generar uno con: openssl rand -hex 32
JWT_SECRET=4f8a6d2e9b1c3f7a5d8e2b9c4f6a1d3e7b5c8f2a6d9e1c4b7f3a5d8e2b9c6f1a
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Configuración de intentos de login
SECURITY_LOGIN_MAX_INTENTOS=5
SECURITY_LOGIN_BLOQUEO_DURACION_MINUTOS=15

# ==============================================
# EMAIL
# ==============================================
# Para Gmail, necesitas una "Contraseña de aplicación" en lugar de tu contraseña normal
# Ve a: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-de-aplicacion
EMAIL_FROM=noreply@veterinaria.com

# ==============================================
# FRONTEND / URLS
# ==============================================
# URL del frontend (para links en emails de confirmación de citas, etc.)
FRONTEND_URL=http://localhost:3000

# ==============================================
# INFORMACIÓN DE CONTACTO
# ==============================================
# Información de contacto que aparecerá en los emails
CONTACTO_TELEFONO=+57 300 123 4567
CONTACTO_DIRECCION=Calle Principal 123, Ciudad
CONTACTO_EMAIL=contacto@veterinaria.com

# ==============================================
# CORS
# ==============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_NAME=logs/veterinaria.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30

# ==============================================
# CONFIGURACIÓN PERSONALIZADA
# ==============================================
APP_UPLOAD_DIR=uploads
APP_MAX_FILE_SIZE=5MB
APP_NOMBRE=Clínica Veterinaria UniHumboldt

# ==============================================
# JPA / HIBERNATE
# ==============================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_BATCH_SIZE=20

