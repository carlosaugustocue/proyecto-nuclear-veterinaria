							"raw": "{{baseUrl}}/api/v1/clientes/buscar?termino=Juan",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "buscar"],
							"query": [
								{
									"key": "termino",
									"value": "Juan",
									"description": "Término de búsqueda (busca en nombre y apellido)"
								}
							]
						},
						"description": "Busca clientes por nombre o apellido (búsqueda parcial)."
					},
					"response": []
				},
