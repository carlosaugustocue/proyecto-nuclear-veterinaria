						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/dni/12345678",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "dni", "12345678"]
						},
						"description": "Busca un cliente específico por su DNI."
					},
					"response": []
				},
				{
					"name": "Buscar por Email",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/email?email=juan.perez@example.com",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "email"],
							"query": [
								{
									"key": "email",
									"value": "juan.perez@example.com",
