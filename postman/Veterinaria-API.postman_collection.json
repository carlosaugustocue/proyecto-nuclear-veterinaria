						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/ciudad/Bogotá",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "ciudad", "Bogotá"]
						},
						"description": "Busca todos los clientes de una ciudad específica."
					},
					"response": []
				},
				{
					"name": "Clientes con Pacientes Activos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/con-pacientes-activos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "con-pacientes-activos"]
						},
						"description": "Obtiene la lista de clientes que tienen al menos un paciente activo."
					},
					"response": []
				}
			],
			"description": "Endpoints para gestión de clientes (propietarios de mascotas)"
		},
		{
			"name": "Pacientes",
