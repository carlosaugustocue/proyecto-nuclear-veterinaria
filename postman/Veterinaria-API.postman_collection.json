							"raw": "{{baseUrl}}/api/v1/pacientes",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "pacientes"]
						},
						"description": "Crea un nuevo paciente (perro) en el sistema. El clienteId debe existir previamente."
					},
					"response": []
				},
