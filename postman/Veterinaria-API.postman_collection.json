							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Max\",\n  \"especie\": \"PERRO\",\n  \"raza\": \"Labrador Retriever\",\n  \"fechaNacimiento\": \"2021-01-15\",\n  \"sexo\": \"MACHO\",\n  \"color\": \"Dorado\",\n  \"pesoKg\": 30.5,\n  \"microchip\": \"123456789012345\",\n  \"observaciones\": \"Paciente sano y muy activo. Vacunas al día.\",\n  \"fotoUrl\": null,\n  \"clienteId\": 1\n}"
						},
