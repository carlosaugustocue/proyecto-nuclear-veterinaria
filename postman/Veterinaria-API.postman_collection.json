						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"juan.nuevo@example.com\",\n  \"telefono\": \"3009876543\",\n  \"direccion\": \"Calle 456 #78-90\",\n  \"ciudad\": \"Medellín\",\n  \"departamento\": \"Antioquia\",\n  \"codigoPostal\": \"050001\",\n  \"observaciones\": \"Observaciones actualizadas - Cliente se mudó a Medellín\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "1"]
						},
						"description": "Actualiza los datos de un cliente existente. No se puede actualizar nombre, apellido ni DNI."
					},
					"response": []
				},
				{
					"name": "Eliminar Cliente",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/clientes/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "clientes", "1"]
						},
						"description": "Elimina un cliente del sistema. No se puede eliminar si tiene pacientes activos."
					},
					"response": []
				},
				{
					"name": "Buscar por Nombre o Apellido",
					"request": {
						"method": "GET",
						"header": [],
